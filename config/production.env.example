# KRTC PAO Notification Host V6.7.0-RC production template
# 請由 Installer 或現場程序提供所有 replace-* 值，禁止提交真實憑證。
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,replace-with-pao-ip
DJANGO_CSRF_TRUSTED_ORIGINS=http://replace-with-pao-ip
DJANGO_CORS_ALLOWED_ORIGINS=http://replace-with-pao-ip
KRTC_PERSISTENT_ROOT=C:\KRTC\NotificationHost

KRTC_STATION_CODE=replace-with-station-code
KRTC_NOTIFICATION_HOST_CODE=replace-with-pao-host-code
KRTC_NOTIFICATION_HOST_IP=replace-with-pao-ip

INFERENCE_WS_AUTOSTART=True
INFERENCE_POLL_AUTOSTART=False
KRTC_INFERENCE_BASE_URL=http://replace-with-inference-host:8000
KRTC_INFERENCE_WEBSOCKET_URL=ws://replace-with-inference-host:8000/ws/alerts
KRTC_INFERENCE_WEBSOCKET_TOKEN=

KRTC_OCC_SYNC_ENABLED=False
KRTC_MAINTENANCE_API_BASE_URL=http://replace-with-occ-host:8000
KRTC_OCC_API_TOKEN=

KRTC_NVR_RECORDING_MODE=nvr
KRTC_NVR_DEFAULT_HOST=
KRTC_NVR_DEFAULT_PORT=80
KRTC_NVR_DEFAULT_USERNAME=
KRTC_NVR_DEFAULT_PASSWORD=
KRTC_NVR_TIME_ZONE=Asia/Taipei
KRTC_NVR_POLL_INTERVAL_SECONDS=60
KRTC_NVR_EXPORT_WARNING_SECONDS=3600
KRTC_NVR_EXPORT_TIMEOUT_SECONDS=7200
KRTC_NVR_MAX_RETRIES=120
KRTC_NVR_WORKER_BATCH_SIZE=20
KRTC_NVR_DOWNLOAD_TIMEOUT_SECONDS=30
KRTC_NVR_MAX_VIDEO_BYTES=2147483648
KRTC_NVR_DOWNLOAD_CHUNK_BYTES=1048576
KRTC_EVENT_MEDIA_RETENTION_DAYS=30

# 僅作為 Broadcast Engineering Settings 尚未初始化時的舊版 bootstrap 相容值。
# 正式部署預設為 PJSIP；Simulation 僅由 Superuser 於 Django Admin 明確啟用。
BROADCAST_PLAYBACK_MODE=pjsip
BROADCAST_SCHEDULER_AUTOSTART=True
BROADCAST_QUEUE_COOLDOWN_SECONDS=30
BROADCAST_QUEUE_TTL_SECONDS=120
BROADCAST_QUEUE_MAX_WORKERS=4
PJSIP_EXECUTABLE_PATH=
PJSIP_LOCAL_IP=
PJSIP_ADVERTISE_IP=

KRTC_ENABLE_HTTPS=False
DJANGO_SECURE_HSTS_SECONDS=0
KRTC_SUPERUSER_USB_REQUIRED=False
KRTC_SUPERUSER_USB_TOKEN_SHA256=
KRTC_DEFAULT_ADMIN_ENABLED=False
KRTC_DEFAULT_ADMIN_USERNAME=admin
KRTC_DEFAULT_ADMIN_PASSWORD=
KRTC_DEFAULT_SUPERUSER_ENABLED=False
KRTC_DEFAULT_SUPERUSER_USERNAME=skynet
KRTC_DEFAULT_SUPERUSER_PASSWORD=
