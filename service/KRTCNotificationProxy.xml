<service>
  <id>KRTCNotificationProxy</id>
  <name>KRTC Notification HTTPS Proxy</name>
  <description>KRTC PAO Notification Host V6.8 HTTPS Reverse Proxy</description>
  <executable>cmd.exe</executable>
  <arguments>/c "C:\KRTC\NotificationHost\service\start_caddy.cmd"</arguments>
  <workingdirectory>C:\KRTC\NotificationHost\service</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>C:\KRTC\NotificationHost\logs\caddy</logpath>
  <log mode="roll">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
