# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,replace-with-pao-ip
DJANGO_CSRF_TRUSTED_ORIGINS=http://replace-with-pao-ip:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://replace-with-pao-ip:8000

# Stable system identities (do not substitute IP addresses for these codes)
KRTC_STATION_CODE=replace-with-station-code
KRTC_NOTIFICATION_HOST_CODE=replace-with-pao-host-code
KRTC_NOTIFICATION_HOST_IP=replace-with-pao-ip

# Three-host endpoints
KRTC_MAINTENANCE_API_BASE_URL=http://replace-with-occ-host:8000
KRTC_INFERENCE_HOST_CODE=replace-with-inference-host-code
KRTC_INFERENCE_BASE_URL=http://replace-with-inference-host:8000
KRTC_INFERENCE_WEBSOCKET_URL=ws://replace-with-inference-host:8000/ws/alerts

# Use different random values for OCC API and Inference WebSocket.
# Never commit real tokens to Git or include them in release ZIP files.
KRTC_OCC_API_TOKEN=replace-with-random-occ-api-token
KRTC_INFERENCE_WEBSOCKET_TOKEN=replace-with-random-inference-ws-token

KRTC_REQUEST_TIMEOUT=10
KRTC_HEARTBEAT_INTERVAL=15
KRTC_OFFLINE_THRESHOLD=90
KRTC_OCC_SYNC_ENABLED=False
KRTC_OCC_HEARTBEAT_PATH=/api/v1/heartbeat/
KRTC_OCC_EVENTS_PATH=/api/v1/events/
KRTC_OCC_DEVICE_STATUS_PATH=/api/v1/devices/sync/
KRTC_OCC_DAILY_SYNC_PATH=/api/v1/daily-sync/
KRTC_OCC_EVENT_BATCH_SIZE=100
KRTC_OCC_DAILY_SYNC_HOUR=2
KRTC_OCC_LOG_RETENTION_DAYS=30
# 可選的絕對路徑；預設為 <KRTC_PERSISTENT_ROOT>\runtime\occ_sync_status.json
# KRTC_OCC_SERVICE_STATUS_PATH=C:\KRTC\NotificationHost\runtime\occ_sync_status.json
KRTC_OCC_VERIFY_TLS=True
INFERENCE_WS_HEARTBEAT_TIMEOUT_SECONDS=90
INFERENCE_WS_RECONNECT_MAX_SECONDS=30
INFERENCE_WS_CATCHUP_LIMIT=100
INFERENCE_WS_PROCESS_BROADCASTS=True

# Broadcast playback: simulation or pjsip
BROADCAST_PLAYBACK_MODE=simulation
PJSIP_EXECUTABLE_PATH=
PJSIP_LOCAL_IP=
PJSIP_ADVERTISE_IP=

# Dedicated scheduler process. Keep Web autostart disabled.
BROADCAST_SCHEDULER_AUTOSTART=False
BROADCAST_SCHEDULER_INTERVAL_SECONDS=15
BROADCAST_QUEUE_COOLDOWN_SECONDS=30
BROADCAST_QUEUE_TTL_SECONDS=120
BROADCAST_QUEUE_MAX_WORKERS=4
# Optional absolute path. Default: <project>\runtime
# BROADCAST_SCHEDULER_RUNTIME_DIR=C:\Users\USER\krtc_notification_host_v6\runtime
KRTC_EXTERNAL_STATION_MAPPING=美麗島站=KRTC-ST-001,R16_左營=KRTC-ST-001


# Automatic inference host polling (starts with Django server)
INFERENCE_POLL_AUTOSTART=True
INFERENCE_POLL_INTERVAL_SECONDS=5
INFERENCE_POLL_EVENT_LIMIT=100
INFERENCE_POLL_EVENT_OFFSET=0
INFERENCE_POLL_STARTUP_DELAY_SECONDS=2

# Automatic WebSocket listener (starts with Django server)
INFERENCE_WS_AUTOSTART=True
INFERENCE_WS_AUTOSTART_DELAY_SECONDS=3
INFERENCE_WS_HOST_REFRESH_SECONDS=30
KRTC_INFERENCE_WEBSOCKET_PATH=/ws/alerts
INFERENCE_WS_TOKEN_ENABLED=False
INFERENCE_WS_EXPECTED_SOURCE_HOST=INF-KRTC-ST-001-01

# Dashboard health result freshness window
INFERENCE_HEALTH_STALE_SECONDS=60

# MediaMTX瀏覽器轉送；攝影機憑證只屬於MediaMTX服務程序環境，禁止放入前端設定。
KRTC_MEDIAMTX_ENABLED=False
KRTC_MEDIAMTX_WEBRTC_BASE_URL=http://127.0.0.1:8889
KRTC_MEDIAMTX_API_BASE_URL=http://127.0.0.1:9997
KRTC_MEDIAMTX_API_TIMEOUT_SECONDS=3
KRTC_MEDIAMTX_PHASE1_CAMERA_CODES=CAM-001,CAM-002,CAM-003,CAM-004
KRTC_MONITOR_MEDIA_MODE=mediamtx
KRTC_MONITOR_MOSAIC_FALLBACK=True

# NVR event recording evidence.
# Default simulation creates a traceable local evidence file without calling NVR.
# Use nvr mode only after each Camera has nvr_host/nvr_channel configured.
KRTC_NVR_RECORDING_MODE=simulation
KRTC_NVR_DEFAULT_HOST=
KRTC_NVR_DEFAULT_PORT=80
KRTC_NVR_DEFAULT_USERNAME=
KRTC_NVR_DEFAULT_PASSWORD=
KRTC_NVR_EXPORT_FORMAT=MP4
KRTC_NVR_TIME_ZONE=Asia/Taipei
KRTC_NVR_PRE_EVENT_SECONDS=30
KRTC_NVR_POST_EVENT_SECONDS=90
KRTC_NVR_POLL_INTERVAL_SECONDS=60
KRTC_NVR_EXPORT_WARNING_SECONDS=3600
KRTC_NVR_EXPORT_TIMEOUT_SECONDS=7200
KRTC_NVR_MAX_RETRIES=120
KRTC_NVR_REQUEST_TIMEOUT=10
KRTC_NVR_WORKER_BATCH_SIZE=20
KRTC_NVR_DOWNLOAD_TIMEOUT_SECONDS=30
KRTC_NVR_MAX_VIDEO_BYTES=2147483648
KRTC_NVR_DOWNLOAD_CHUNK_BYTES=1048576
KRTC_EVENT_MEDIA_RETENTION_DAYS=30
KRTC_EVENT_MEDIA_RETENTION_BATCH_SIZE=100

# V6.6 persistent data layout (recommended for installed/field systems).
# Development can leave this unset to keep db.sqlite3/media under the project root.
# KRTC_PERSISTENT_ROOT=C:\KRTC\NotificationHost
# Optional overrides:
# KRTC_CONFIG_DIR=C:\KRTC\NotificationHost\config
# KRTC_DATA_DIR=C:\KRTC\NotificationHost\data
# KRTC_MEDIA_DIR=C:\KRTC\NotificationHost\media
# KRTC_LOG_DIR=C:\KRTC\NotificationHost\logs
# KRTC_BACKUP_DIR=C:\KRTC\NotificationHost\backups
