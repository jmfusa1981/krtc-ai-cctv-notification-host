# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.6.25
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.6.25:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://192.168.6.25:8000

# Stable system identities (do not substitute IP addresses for these codes)
KRTC_STATION_CODE=KRTC-ST-001
KRTC_NOTIFICATION_HOST_CODE=NH-KRTC-ST-001
KRTC_NOTIFICATION_HOST_IP=192.168.6.25
KRTC_APP_VERSION=PAO-V5

# Three-host endpoints
KRTC_MAINTENANCE_API_BASE_URL=http://140.124.42.72:8000
KRTC_INFERENCE_HOST_CODE=INF-KRTC-ST-001-01
KRTC_INFERENCE_BASE_URL=http://192.168.6.20:8000
KRTC_INFERENCE_WEBSOCKET_URL=ws://192.168.6.20:8000/ws/alerts
KRTC_INFERENCE_WEBSOCKET_PATH=/ws/events
INFERENCE_WS_EXPECTED_SOURCE_HOST=INF-TEST-001

# Use different random values for OCC API and Inference WebSocket.
# Never commit real tokens to Git or include them in release ZIP files.
KRTC_OCC_API_TOKEN=replace-with-random-occ-api-token
KRTC_INFERENCE_WEBSOCKET_TOKEN=replace-with-random-inference-ws-token
INFERENCE_WS_TOKEN_ENABLED=True

KRTC_REQUEST_TIMEOUT=10
KRTC_HEARTBEAT_INTERVAL=15
KRTC_OFFLINE_THRESHOLD=90
KRTC_OCC_SYNC_ENABLED=False
KRTC_OCC_HEARTBEAT_PATH=/api/v1/heartbeat/
KRTC_OCC_EVENTS_PATH=/api/v1/events/
KRTC_OCC_DEVICE_STATUS_PATH=/api/v1/devices/sync/
KRTC_OCC_DAILY_SYNC_PATH=/api/v1/daily-sync/
KRTC_OCC_EVENT_BATCH_SIZE=100
KRTC_OCC_DAILY_SYNC_HOUR=2
KRTC_OCC_VERIFY_TLS=True
INFERENCE_WS_HEARTBEAT_TIMEOUT_SECONDS=90
INFERENCE_WS_RECONNECT_MAX_SECONDS=30
INFERENCE_WS_CATCHUP_LIMIT=100
INFERENCE_WS_PROCESS_BROADCASTS=True

# Broadcast playback: simulation or pjsip
BROADCAST_PLAYBACK_MODE=simulation
PJSIP_EXECUTABLE_PATH=C:\krtc-tools\pjsip\pjsua.exe
PJSIP_LOCAL_IP=
PJSIP_ADVERTISE_IP=

# Dedicated scheduler process. Keep Web autostart disabled.
BROADCAST_SCHEDULER_AUTOSTART=False
BROADCAST_SCHEDULER_INTERVAL_SECONDS=15
# Optional absolute path. Default: <project>\runtime
# BROADCAST_SCHEDULER_RUNTIME_DIR=C:\Users\USER\krtc_notification_host_v4\runtime
KRTC_EXTERNAL_STATION_MAPPING=美麗島站=KRTC-ST-001,R16_左營=KRTC-ST-001


# Automatic inference host polling (starts with Django server)
INFERENCE_POLL_AUTOSTART=True
INFERENCE_POLL_INTERVAL_SECONDS=5
INFERENCE_POLL_EVENT_LIMIT=100
INFERENCE_POLL_EVENT_OFFSET=0
INFERENCE_POLL_STARTUP_DELAY_SECONDS=2

# Automatic WebSocket listener (starts with Django server)
INFERENCE_WS_AUTOSTART=True
INFERENCE_WS_AUTOSTART_DELAY_SECONDS=3
INFERENCE_WS_HOST_REFRESH_SECONDS=30
KRTC_INFERENCE_WEBSOCKET_PATH=/ws/alerts
INFERENCE_WS_TOKEN_ENABLED=False
INFERENCE_WS_EXPECTED_SOURCE_HOST=INF-KRTC-ST-001-01

# Dashboard health result freshness window
INFERENCE_HEALTH_STALE_SECONDS=20

# NVR event recording evidence.
# Default simulation creates a traceable local evidence file without calling NVR.
# Use nvr mode only after each Camera has nvr_host/nvr_channel configured.
KRTC_NVR_RECORDING_MODE=simulation
KRTC_NVR_DEFAULT_HOST=
KRTC_NVR_DEFAULT_PORT=80
KRTC_NVR_DEFAULT_USERNAME=
KRTC_NVR_DEFAULT_PASSWORD=
KRTC_NVR_EXPORT_FORMAT=MP4
KRTC_NVR_PRE_EVENT_SECONDS=30
KRTC_NVR_POST_EVENT_SECONDS=90
KRTC_NVR_REQUEST_TIMEOUT=10
